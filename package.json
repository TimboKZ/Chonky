{
  "name": "@fsg/file-browser",
  "version": "1.0.0",
  "description": "A modern, accessible file browser component for React — the FSG rebuild of Chonky",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/styles.css",
    "CHANGELOG.md",
    "MIGRATION.md",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/fsg": {
      "types": "./dist/adapter/fsg/index.d.ts",
      "import": "./dist/adapter/fsg/index.js"
    },
    "./viewers": {
      "types": "./dist/preview/index.d.ts",
      "import": "./dist/preview/index.js"
    },
    "./images": {
      "types": "./dist/images/index.d.ts",
      "import": "./dist/images/index.js"
    },
    "./chonky-compat": {
      "types": "./dist/compat/index.d.ts",
      "import": "./dist/compat/index.js"
    },
    "./styles": {
      "default": "./src/styles.css"
    },
    "./fsg": {
      "types": "./dist/fsg/index.d.ts",
      "import": "./dist/fsg/index.js"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6007",
    "build": "vite build --config vite.config.lib.ts && tsc --project tsconfig.build.json",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:browser": "vitest run --config=vitest.browser.config.ts",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@fsg/gui-bytes": ">=5.35.0",
    "@react-three/drei": "^9.0.0 || ^10.0.0",
    "@react-three/fiber": "^8.18.0 || ^9.0.0",
    "docx-preview": ">=0.3.0",
    "libheif-js": ">=1.19.0",
    "lucide-react": ">=0.477.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "sonner": "^2.0.0",
    "three": ">=0.160.0",
    "xlsx": ">=0.18.0"
  },
  "peerDependenciesMeta": {
    "docx-preview": {
      "optional": true
    },
    "libheif-js": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "xlsx": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "@react-three/drei": {
      "optional": true
    }
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.10.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@fsg/gui-bytes": "link:../gui-bytes",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@storybook/addon-docs": "^10.0.5",
    "@storybook/react-vite": "^10.0.5",
    "@tailwindcss/vite": "^4.0.10",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^4.0.17",
    "@vitest/browser-playwright": "^4.0.17",
    "docx-preview": "^0.4.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "lucide-react": "^0.562.0",
    "playwright": "^1.50.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "storybook": "^10.0.5",
    "tailwindcss": "^4.0.10",
    "three": "^0.185.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vite-plugin-lib-inject-css": "^2.2.1",
    "vitest": "^4.0.17",
    "vitest-browser-react": "^2.0.2",
    "xlsx": "^0.18.5"
  },
  "keywords": [
    "file-browser",
    "file-manager",
    "react",
    "fsg",
    "chonky"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facilitysolutionsgroup/file-browser.git"
  }
}
