# Storybook: point the "Dev file storage" stories at a real backend.
#
# Copy to `.env.local` and fill in an area and entity you have files under.
# Everything else defaults to dev, so the copy is usually enough.
#
# Auth is the `fsg_apps_session` cookie. Sign in to any dev FSG app in the same
# browser (or use the Sign in button the story shows) and Storybook picks it up:
# the gateway allows `http://localhost:*` as a CORS origin with credentials.
#
# A bearer token is deliberately NOT supported here. Image, PDF and video
# previews load through `<img>` and `<iframe>` `src` attributes, which cannot
# carry an Authorization header — only the cookie makes those work.

VITE_API_GATEWAY_BASE_URL=https://api.dev.fsgapps.com
VITE_IDENTITY_SERVICE_URL=https://identity.dev.fsgapps.com

# The storage area. Defaults to engage-v2, which is the one with the most in it.
VITE_FILE_STORAGE_AREA=engage-v2

# Which folder to open. "/" browses the whole area and lists every entity folder
# in it, which is usually what you want. Set a path to open one entity directly.
VITE_FILE_STORAGE_ROOT_PATH=/
